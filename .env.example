# Local single-user workspace. Never put service credentials in the frontend.
COUNCIL_MODE=simulation
COUNCIL_DATA_DIR=private
COUNCIL_SERVICE_KEY=
COUNCIL_GEMINI_KEY=
# Select and verify a current supported model before enabling live mode.
COUNCIL_GEMINI_MODEL=
COUNCIL_LIVE_QUALITY_APPROVED=false
COUNCIL_TIMEOUT_SECONDS=45
COUNCIL_CORS_ORIGIN=http://127.0.0.1:5173
# Only for a trusted proxy whose listening port is bound to host loopback (compose.yml).
COUNCIL_TRUST_LOOPBACK_PROXY=false
